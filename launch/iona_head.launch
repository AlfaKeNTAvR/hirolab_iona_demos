<?xml version="1.0"?>
<launch>
    <!-- ============================ SETTINGS ============================= -->


    <!-- If any of dependency or optional subfiles should not be launched (or
    are launched separately) set corresponding argument to "false". -->
    <arg 
    name="unity_ros_launch" 
    default="true"/>

    <arg 
    name="camera_launch" 
    default="true"/>

    <arg 
    name="active_neck_launch" 
    default="true"/>

    <!-- ======================== END OF SETTINGS ========================== -->

    <!-- Unity-ROS: -->
    <group if="$(arg unity_ros_launch)">
        <include 
        file="$(find unity_ros)/launch/endpoint.launch">
        </include>
    </group>


    <!-- Active neck: -->
    <group if="$(arg active_neck_launch)">
        <include 
        file="$(find active_neck)/launch/active_neck.launch">
            <arg 
            name="launch_headset_feedback" 
            value="true"/>
        </include>
    </group>


    <!-- Camera and UDP: -->
    <group if="$(arg camera_launch)">
        <include 
        file="$(find realsense2_camera)/launch/rs_camera.launch">
            <arg 
            name="camera" 
            value="active_neck"/>
            <arg 
            name="serial_no" 
            value="920312070370"/>
            <arg 
            name="color_fps" 
            value="30"/>
            <arg 
            name="color_width" 
            value="640"/>
            <arg 
            name="color_height" 
            value="480"/> 
            <!-- <arg 
            name="publish_tf" 
            value="true"/>  -->
        </include>
    </group>

    <!-- WiFi Strength indicator: -->
    <node pkg="hirolab_iona_demos" type="wifi.py" name="wifi_node" output="screen" />
</launch>