<?xml version="1.0"?>
<launch>
   <!-- Calibration procedure:
   1. Home both arms.

   2. Send right arm to the calibration point:
   rosservice call /right_arm/oculus_mapping/move_to_frame "data: 'right_calibration'"
   
   3. Send left arm to the calibration point:
   rosservice call /left_arm/oculus_mapping/move_to_frame "data: 'left_calibration'"

   4. Rotate the base parallel to the bedhead panel.

   5. Shift the bedhead panel sideways to match the right socket with the right
      arm EE tip.

   6. Replace X Y Z from this broadcaster with the values from here:
   rosrun tf tf_echo /base_link /right_arm/tool_frame

   7. Subtract 0.02 from X to account for the tool_frame location to the tip of
      the EE.
   -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_socket_base_broadcaster" 
    args="0.820 -0.440 1.44 0 0 0 base_link right_socket"
    />

    <!-- Left socket broadcaster: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="left_socket_broadcaster" 
    args="-0.08 0.15 -0.102 0 0 0 bedhead_panel_base left_socket"
    />

    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="left_socket_zone_broadcaster" 
    args="-0.04 0 0 0 0 0 left_socket left_socket_zone"
    />

    <!-- Right socket broadcaster: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_socket_broadcaster" 
    args="0.065 0.340 0.102 0 0 0 right_socket bedhead_panel_base"
    />

    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_socket_zone_broadcaster" 
    args="-0.04 0 0 0 0 0 right_socket right_socket_zone"
    />

    <!-- EE plug tip: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_plug_broadcaster" 
    args="0 0 0.18 0 0 0 right_arm/end_effector_link right_arm/plug_tip"
    />

    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="left_plug_broadcaster" 
    args="0 0 0.18 0 0 0 left_arm/end_effector_link left_arm/plug_tip"
    />

    <!-- Starting point: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="start_point_broadcaster" 
    args="-0.4 0 -0.102 0 0 0 bedhead_panel_base start_point"
    />

    <!-- Starting point 2: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="start_point2_broadcaster" 
    args="-0.4 0 -0.102 0 1.57 0 bedhead_panel_base start_point2"
    />

    <!-- Center point: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="center_point_broadcaster" 
    args="0 -0.2475 0 0 0 0 left_socket center_point"
    />

    <!-- Right and left arm calibration poses: -->
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="right_calibration_broadcaster" 
    args="0.84 -0.44 1.46 0 0 0 base_link right_calibration"
    />
    <node 
    pkg="tf2_ros" 
    type="static_transform_publisher" 
    name="left_calibration_broadcaster" 
    args="0 0.495 -0.01 0 0 0 right_calibration left_calibration"
    />
</launch>