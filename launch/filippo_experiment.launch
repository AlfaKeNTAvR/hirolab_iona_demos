<?xml version="1.0"?>
<launch>
    <!-- ============================ SETTINGS ============================= -->

    <arg 
    name="udp_ip" 
    default="192.168.0.107"/>

    <arg 
    name="active_neck_udp_port" 
    default="8085"/>
    
    <arg 
    name="teleop_phase_udp_port" 
    default="8050"/>

    <!-- If any of dependency or optional subfiles should not be launched (or
    are launched separately) set corresponding argument to "false". -->
    <arg 
    name="launch_unity_ros" 
    default="true"/>

    <arg 
    name="launch_active_neck" 
    default="true"/>


    <!-- ======================== END OF SETTINGS ========================== -->

    <!-- Unity-ROS: -->
    <group if="$(arg launch_unity_ros)">
        <include 
        file="$(find unity_ros)/launch/endpoint.launch">
        </include>
    </group>

    <!-- Mobile Base Oculus Mapping: -->
    <include 
        file="$(find hirolab_fetch_freight100)/launch/oculus_mobile_base_mapping.launch">
            <arg 
            name="controller_side" 
            value="right"/>
            <arg 
            name="launch_controller_feedback" 
            value="true"/>
    </include>

    <!-- Active neck: -->
    <group if="$(arg launch_active_neck)">
        <include 
        file="$(find active_neck)/launch/active_neck.launch">
            <arg 
            name="launch_headset_feedback" 
            value="true"/>
        </include>
    </group>

    <!-- Active neck camera: -->
    <include 
    file="$(find realsense2_camera)/launch/rs_camera.launch">
        <arg 
        name="camera" 
        value="active_neck"/>
        <arg 
        name="serial_no" 
        value="920312070370"/>
        <arg 
        name="color_fps" 
        value="30"/>
        <arg 
        name="color_width" 
        value="640"/>
        <arg 
        name="color_height" 
        value="480"/>   
    </include>

    <!-- Active neck camera UDP streamer: -->
    <include 
    file="$(find udp_ros)/launch/udp_streamer.launch">
        <arg 
        name="enable_imshow" 
        default="true"/>
        <arg 
        name="camera_name" 
        value="active_neck"/>
        <arg 
        name="image_topic" 
        default="/active_neck/color/image_raw"/>
        <arg 
        name="udp_ip" 
        value="$(arg udp_ip)"/>
        <arg 
        name="udp_port" 
        value="$(arg active_neck_udp_port)"/> 
        <arg 
        name="fps_rate" 
        default="30"/>
    </include>

    <!-- Teleoperation phase UDP streamer: -->
    <include 
    file="$(find udp_ros)/launch/teleop_udp_streamer.launch">
        <arg 
        name="udp_ip" 
        value="$(arg udp_ip)"/>
        <arg 
        name="udp_port" 
        value="$(arg teleop_phase_udp_port)"/> 
    </include>
</launch>