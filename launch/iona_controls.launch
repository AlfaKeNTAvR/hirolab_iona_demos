<?xml version="1.0"?>
<launch>
    <!-- ============================ SETTINGS ============================= -->

    <arg name="right_arm_launch"    default="true"/>
    <arg name="left_arm_launch"     default="true"/>
    <arg name="base_launch"         default="true"/>
    <arg name="torso_launch"        default="true"/>
    <arg name="headset_mode"        default="head"/>

    <!-- mapping_player: path to the .mapping.json control file.
         Publish a std_msgs/String to /mapping_player/file_path at runtime
         to hot-swap to a different mapping without restarting. -->
    <arg name="mapping_file"        default="/home/fetch/catkin_workspaces/iona_devel_ws/pose_mapping.json"/>

    <!-- ======================== END OF SETTINGS ========================== -->


    <!-- ==================== RIGHT ARM ==================== -->
    <group if="$(arg right_arm_launch)">

        <!-- Oculus controller feedback (buttons, pose, joystick topics) -->
        <include file="$(find oculus_ros)/launch/controller_feedback.launch">
            <arg name="controller_side" value="right"/>
        </include>

        <!-- Service-driven teleoperation node -->
        <include file="$(find kinova_positional_control)/launch/teleoperation_service.launch">
            <arg name="robot_name" value="right_arm"/>
        </include>

        <!-- Preset poses -->
        <include file="$(find kinova_positional_control)/launch/preset_poses.launch">
            <arg name="robot_name" value="right_arm"/>
        </include>

        <!-- Wrench -->
        <include file="$(find kinova_positional_control)/launch/kinova_wrench.launch">
            <arg name="robot_name" value="right_arm"/>
        </include>

    </group>


    <!-- ==================== LEFT ARM ==================== -->
    <group if="$(arg left_arm_launch)">

        <!-- Oculus controller feedback (buttons, pose, joystick topics) -->
        <include file="$(find oculus_ros)/launch/controller_feedback.launch">
            <arg name="controller_side" value="left"/>
        </include>

        <!-- Service-driven teleoperation node -->
        <include file="$(find kinova_positional_control)/launch/teleoperation_service.launch">
            <arg name="robot_name" value="left_arm"/>
        </include>

        <!-- Preset poses -->
        <include file="$(find kinova_positional_control)/launch/preset_poses.launch">
            <arg name="robot_name" value="left_arm"/>
        </include>

        <!-- Wrench -->
        <include file="$(find kinova_positional_control)/launch/kinova_wrench.launch">
            <arg name="robot_name" value="left_arm"/>
        </include>

    </group>


    <!-- ==================== MOBILE BASE ==================== -->
    <!-- Hardware driver only.  Joystick control is now handled by mapping_player
         (see the mobile base section in the active .mapping.json file).
         The old oculus_mobile_base_mapping.py node is intentionally NOT launched
         here — launching it alongside mapping_player would cause both nodes to
         subscribe to /right/controller_feedback/joystick and publish conflicting
         velocity commands simultaneously. -->
    <group if="$(arg base_launch)">
        <include file="$(find hirolab_fetch_freight100)/launch/velocity_control.launch">
            <arg name="max_forward_speed" value="0.25"/>
            <arg name="max_angular_speed" value="0.5"/>
        </include>
    </group>


    <!-- ==================== TORSO ==================== -->
    <!-- Hardware driver only.  Joystick control is now handled by mapping_player
         (see the chest section in the active .mapping.json file).
         The old oculus_joystick_mapping.py node is intentionally NOT launched
         here — launching it alongside mapping_player would cause both nodes to
         subscribe to /left/controller_feedback/joystick and publish conflicting
         velocity commands simultaneously. -->
    <group if="$(arg torso_launch)">
        <include file="$(find gopher_ros_clearcore)/launch/chest.launch">
            <arg name="start_position" value="-1"/>
        </include>
    </group>


    <!-- ==================== STATIC TF ==================== -->

    <!-- Headset base_link offset -->
    <node pkg="tf2_ros"
          type="static_transform_publisher"
          name="headset_broadcaster"
          args="-1.5 0 0 0 0 0 1 base_link headset/base_link"/>

    <!-- Robot tracker -->
    <node pkg="tf2_ros"
          type="static_transform_publisher"
          name="robot_tracker_broadcaster"
          args="-0.1 0.147 1.64 -0.5 -0.5 -0.5 0.5 base_link robot_tracker"/>


    <!-- ==================== MAPPING PLAYER ==================== -->
    <!-- Executes the .mapping.json control graph.
         Publish a new file path to /mapping_player/file_path at runtime
         to hot-swap the active mapping without restarting any nodes.

         Bundled mappings:
           dual_arm_oculus.mapping.json  — pose tracking + base/chest (default)
           joystick_mapping.json         — joystick arm control + base/chest when idle
    -->
    <node pkg="kinova_positional_control"
          type="mapping_player.py"
          name="mapping_player"
          output="screen">
        <param name="mapping_file" value="$(arg mapping_file)"/>
    </node>

</launch>
